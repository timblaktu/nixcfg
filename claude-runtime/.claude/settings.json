{
  "hooks": {
    "SessionStart": [],
    "Stop": []
  },
  "model": "opus",
  "permissions": {
    "additionalDirectories": [],
    "allow": [
      "Bash",
      "mcp__context7",
      "mcp__mcp-nixos",
      "mcp__sequential-thinking",
      "mcp__serena",
      "Read",
      "Write",
      "Edit",
      "WebFetch"
    ],
    "ask": [],
    "defaultMode": "default",
    "deny": [
      "Search",
      "Find",
      "Bash(rm -rf /*)"
    ]
  },
  "projectOverrides": {
    "enabled": true,
    "searchPaths": [
      ".claude/settings.json",
      ".claude.json",
      "claude.config.json"
    ]
  },
  "statusLine": {
    "command": "claude-statusline-powerline",
    "padding": 0,
    "type": "command"
  }
}
